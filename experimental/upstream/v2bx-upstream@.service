[Unit]
Description=V2bX upstream subscription %i
After=network-online.target
Wants=network-online.target

[Service]
User=v2bx-upstream
Group=v2bx-upstream
ExecStart=/usr/local/bin/v2bx-upstream -config /etc/v2bx-upstream/%i.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/v2bx-upstream
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
